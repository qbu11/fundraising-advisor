{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fundraising advisor project input",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "sectors"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1},
        "product": {"type": ["string", "null"]},
        "sectors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "stage": {"type": ["string", "null"]},
        "round": {"type": ["string", "null"]},
        "amount": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["min_wan_cny", "max_wan_cny", "currency"],
          "properties": {
            "min_wan_cny": {"type": "integer", "minimum": 0},
            "max_wan_cny": {"type": "integer", "minimum": 0},
            "currency": {"type": "string", "minLength": 1}
          }
        },
        "traction": {"type": ["string", "null"]},
        "business_model": {"type": ["string", "null"]},
        "team_highlights": {
          "type": "array",
          "items": {"type": "string"}
        },
        "location": {"type": ["string", "null"]},
        "use_of_funds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fundraising_goal": {"type": ["string", "null"]}
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person_expertise": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exclude_funds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "compliance": {
          "type": "array",
          "items": {"enum": ["trusted", "suspect"]}
        }
      }
    },
    "top_k": {"type": "integer", "minimum": 1, "maximum": 30},
    "language": {"type": "string"}
  }
}
